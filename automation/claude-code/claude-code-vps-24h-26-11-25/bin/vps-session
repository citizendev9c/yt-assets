#!/usr/bin/env bash
# Manage 24h Claude Code sessions on this VPS (each one shows up in the Claude app via Remote Control).
set -euo pipefail

CONF_DIR=/etc/claude-vps/sessions
PROJECTS=/root/projects
LOG_DIR=/var/log/claude-vps

usage() {
  cat <<'EOF'
사용법:
  vps-session new <아이디> "<표시 이름>" [--dir <폴더이름|/경로> | --git <저장소 주소>] [--mode auto|default|acceptEdits] [--telegram]
      폴더를 안 정하면 /root/projects/<아이디>를 새로 만들어요. 권한 기본값은 auto예요.
  vps-session list
  vps-session peek <아이디>            세션 화면 보기 (빈 줄 빼고 마지막 30줄)
  vps-session keys <아이디> <키...>    세션에 글자·키 보내기 (예: keys main Down → peek로 ❯ 확인 → keys main Enter)
  vps-session attach <아이디>          세션 화면에 들어가기 (나올 때 Ctrl+B 누른 뒤 D)
  vps-session start|stop|restart <아이디>
  vps-session remove <아이디>          서비스 끄고 설정 지우기 (작업 폴더는 남김)
  vps-session logs <아이디>
  vps-session doctor                   설치 상태 점검
  vps-session login-check [--test]     서버 Claude 로그인이 3일 안에 끝나면 텔레그램으로 알림 (--test: 지금 시험 알림)
  vps-session autocompact <값|auto> [아이디]
      대화를 요약 정리하는 시점(토큰, 100000 이상). 아이디 없이 = 모든 24시간 세션 기본값. auto = 원래대로
  vps-session harden-ssh               비밀번호 로그인 끄기 (열쇠로만)
  vps-session firewall-basic           방화벽: SSH만 열고 나머지 들어오는 연결 막기
  vps-session firewall-tailscale       방화벽: Tailscale로만 SSH (공인 IP 쪽 22번 닫기)
EOF
}

need_id() {
  [[ "${1:-}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || { echo "아이디는 영문 소문자·숫자·-만, 32자까지예요 (예: main, news-watch)."; exit 1; }
}
unit() { echo "claude-session@$1.service"; }
sock() { echo "cc-$1"; }
# True when the Telegram plugin is enabled for every session (user scope). A disabled entry ("...": false) does not count.
user_enabled() { grep -Eqs '"telegram@[^"]*"[[:space:]]*:[[:space:]]*true' /root/.claude/settings.json; }
# True when the Telegram plugin is enabled in this folder only (local scope).
folder_enabled() { grep -Eqs '"telegram@claude-plugins-official"[[:space:]]*:[[:space:]]*true' "$1/.claude/settings.local.json"; }

cmd="${1:-}"; shift || true
case "$cmd" in
  new)
    id="${1:-}"; need_id "$id"; shift
    title="${1:-$id}"; [ $# -gt 0 ] && shift
    mode=auto; telegram=no; dir="$PROJECTS/$id"; git_url=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --mode) mode="$2"; shift 2 ;;
        --telegram) telegram=yes; shift ;;
        --dir) dir="$2"; shift 2 ;;
        --git) git_url="$2"; shift 2 ;;
        *) echo "모르는 옵션: $1"; exit 1 ;;
      esac
    done
    case "$mode" in default|auto|acceptEdits) ;; *) echo "--mode는 auto·default·acceptEdits 중 하나"; exit 1 ;; esac
    [ -e "$CONF_DIR/$id.conf" ] && { echo "이미 있는 아이디예요: $id (vps-session list)"; exit 1; }
    # Folder: a bare name means /root/projects/<name>; a git URL is cloned there.
    if [ -n "$git_url" ]; then
      repo=$(basename "${git_url%.git}")
      [[ "$repo" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "깃 주소에서 저장소 이름을 못 읽었어요: $git_url"; exit 1; }
      dir="$PROJECTS/$repo"
      if [ ! -d "$dir/.git" ]; then
        command -v git >/dev/null || apt-get install -y git
        if ! GIT_TERMINAL_PROMPT=0 git clone "$git_url" "$dir"; then
          echo "복제에 실패했어요. 비공개 저장소면 Terminal 창에서 먼저: apt-get install -y gh && gh auth login (GitHub.com → HTTPS → 브라우저로 로그인)"
          exit 1
        fi
      fi
    elif [[ "$dir" != /* ]]; then
      dir="$PROJECTS/$dir"
    fi
    [ "$dir" = "/root" ] || [ "$dir" = "/root/" ] && { echo "홈 폴더(/root)는 폴더 믿기가 저장되지 않아요. 프로젝트 폴더를 쓰세요."; exit 1; }
    if grep -l "^WORKDIR=\"$dir\"$" "$CONF_DIR"/*.conf >/dev/null 2>&1; then
      echo "참고: 같은 폴더를 쓰는 세션이 이미 있어요. 다시 켜질 때 '마지막 대화 이어서'가 서로 섞일 수 있어서, 세션마다 다른 폴더를 권해요."
    fi
    if [ "$telegram" != yes ] && folder_enabled "$dir"; then
      echo "이 폴더($dir)는 텔레그램 세션 폴더예요. 여기서 세션을 하나 더 켜면 텔레그램 봇을 가로채요. 다른 폴더를 쓰세요."; exit 1
    fi
    if [ "$telegram" = yes ]; then
      [ -r /root/.claude/channels/telegram/.env ] || { echo "텔레그램 토큰이 없어요. 먼저 Terminal 창에서: vps-secret set telegram"; exit 1; }
      if grep -lE '^TELEGRAM="?yes' "$CONF_DIR"/*.conf >/dev/null 2>&1; then
        echo "텔레그램 세션이 이미 있어요. 같은 봇은 한 세션만 쓸 수 있어요."; exit 1
      fi
    fi
    install -d -m 755 "$CONF_DIR" "$LOG_DIR"
    install -d -m 700 "$dir"
    if [ "$telegram" = yes ]; then
      # The plugin's bot server starts in every session where the plugin is enabled, not only with --channels.
      # Enabled for all sessions (user scope), any other session grabs the same bot and Telegram goes silent.
      # So keep it off at user scope and turn it on only in this folder (local scope = .claude/settings.local.json, kept out of git).
      plugin=telegram@claude-plugins-official
      plugins_now=$(claude plugin list 2>/dev/null || true)
      grep -q "$plugin" <<<"$plugins_now" || {
        echo "$plugin 이 설치돼 있지 않아요. SETUP 6-2(카탈로그 더하기 → 설치 → user 범위 끄기)를 먼저 하세요."; exit 1; }
      if user_enabled; then
        echo "텔레그램 플러그인이 모든 세션에 켜져 있어서 끌게요 (다른 세션이 봇을 가로채지 않게)."
        claude plugin disable "$plugin" --scope user || true
      fi
      (cd "$dir" && { claude plugin enable "$plugin" --scope local || claude plugin install "$plugin" --scope local; }) || {
        echo "이 폴더($dir)에 텔레그램 플러그인을 켜지 못했어요. 멈추고 사용자에게 알려 주세요."; exit 1; }
      folder_enabled "$dir" || {
        echo "이 폴더의 .claude/settings.local.json에 플러그인이 안 보여요. 멈추고 사용자에게 알려 주세요."; exit 1; }
    fi
    # Escape the title for a double-quoted shell assignment.
    esc_title=$(printf '%s' "$title" | sed 's/[\\"$`]/\\&/g')
    cat > "$CONF_DIR/$id.conf" <<EOF
TITLE="$esc_title"
WORKDIR="$dir"
MODE="$mode"
TELEGRAM="$telegram"
EOF
    systemctl daemon-reload
    systemctl enable --now "$(unit "$id")"
    echo "세션 '$title'($id)을 켰어요. 10초 뒤 화면을 보여 드릴게요..."
    sleep 10
    tmux -L "$(sock "$id")" capture-pane -p -t main 2>/dev/null | grep -v '^[[:space:]]*$' | tail -30 || true
    echo
    echo "첫 실행 화면을 하나씩 넘기세요 (Enter 전에 언제나 vps-session peek $id 로 ❯ 위치 확인):"
    echo "  - 테마 고르기 / Press Enter to continue: vps-session keys $id Enter"
    echo "  - 폴더 믿기: 기본이 'No, exit'예요. 사용자 승인 → vps-session keys $id Down(안 되면 Up) → ❯ 가 Yes, I trust this folder 앞에 올 때까지 → vps-session keys $id Enter"
    echo "  - 처음 보는 질문: 멈추고 화면 문구를 사용자에게 보여 주세요."
    echo "끝나면 휴대폰 Claude 앱 Code 목록이나 claude.ai/code에 '$title'이 보여요 (데스크톱 앱 사이드바에는 안 보여요)."
    ;;
  list)
    shopt -s nullglob
    files=("$CONF_DIR"/*.conf)
    [ ${#files[@]} -eq 0 ] && { echo "만든 세션이 없어요. vps-session new <아이디> \"<표시 이름>\""; exit 0; }
    printf '%-14s %-10s %-12s %-9s %s\n' 아이디 상태 권한 텔레그램 표시이름
    for f in "${files[@]}"; do
      id=$(basename "$f" .conf)
      TITLE=""; MODE=""; TELEGRAM=""
      # shellcheck disable=SC1090
      . "$f"
      state=$(systemctl is-active "$(unit "$id")" 2>/dev/null || true)
      printf '%-14s %-10s %-12s %-9s %s\n' "$id" "$state" "$MODE" "$TELEGRAM" "$TITLE"
    done
    ;;
  peek)   id="${1:-}"; need_id "$id"; tmux -L "$(sock "$id")" capture-pane -p -t main | { grep -v '^[[:space:]]*$' || true; } | tail -30 ;;
  keys)   id="${1:-}"; need_id "$id"; shift; tmux -L "$(sock "$id")" send-keys -t main "$@" ;;
  attach) id="${1:-}"; need_id "$id"; echo "나올 때: Ctrl+B 누르고 손 뗀 뒤 D (exit나 /exit는 치지 마세요)"; sleep 1; exec tmux -L "$(sock "$id")" attach -t main ;;
  start|stop|restart) id="${1:-}"; need_id "$id"; systemctl "$cmd" "$(unit "$id")"; systemctl is-active "$(unit "$id")" || true ;;
  remove)
    id="${1:-}"; need_id "$id"
    systemctl disable --now "$(unit "$id")" || true
    if grep -qE '^TELEGRAM="?yes' "$CONF_DIR/$id.conf" 2>/dev/null; then
      wd=$(sed -n 's/^WORKDIR="\(.*\)"$/\1/p' "$CONF_DIR/$id.conf")
      (cd "$wd" && claude plugin disable telegram@claude-plugins-official --scope local) || true
      echo "이 폴더($wd)의 텔레그램 플러그인도 껐어요."
    fi
    rm -f "$CONF_DIR/$id.conf"
    echo "세션 $id 를 지웠어요. 작업 폴더와 대화 기록은 남겨 뒀어요."
    ;;
  logs)   id="${1:-}"; need_id "$id"; tail -n 40 "$LOG_DIR/$id.log" 2>/dev/null; journalctl -u "$(unit "$id")" -n 20 --no-pager ;;
  login-check)
    test=no; [ "${1:-}" = "--test" ] && test=yes
    status_ok=yes; claude auth status >/dev/null 2>&1 || status_ok=no
    line=$(claude auth status --text 2>/dev/null | grep -m1 '^Sign-in' || true)
    first=$(grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' <<<"$line" | head -1 || true)
    days=""
    [ -n "$first" ] && days=$(( ( $(date -d "$first" +%s) - $(date -d "$(date +%F)" +%s) ) / 86400 ))
    how=$'노트북 Claude 앱 → 서버 대화 → Terminal 창 → claude auth login → 브라우저에서 승인 → 코드를 Terminal 창에 붙여 넣기.\n그 뒤 답이 없는 세션은 vps-session restart <아이디>.'
    if [ "$status_ok" = no ] || grep -qE 'may have ended' <<<"$line"; then
      msg=$'⚠️ 서버 Claude 로그인이 끝났어요. 24시간 세션과 텔레그램 답장이 멈춰 있을 수 있어요.\n'"$how"
    elif grep -qE 'any day now' <<<"$line" || { [ -n "$days" ] && [ "$days" -le 3 ]; }; then
      msg="⏰ 서버 Claude 로그인이 ${first:-곧} 무렵 끝나요 (${days:-?}일 남음)."$'\n'"$how"
    elif [ "$test" = yes ]; then
      msg="✅ 로그인 알림 시험이에요. 서버 Claude 로그인은 ${first:-날짜 모름} 무렵 끝나요 (${days:-?}일 남음). 3일 전부터 매일 아침 9시에 알려 드릴게요."
    else
      echo "아직 괜찮아요: ${line:-끝나는 날 정보 없음}"; exit 0
    fi
    vps-notify "$msg"
    ;;
  autocompact)
    val="${1:-}"; id="${2:-}"
    if [ "$val" != auto ]; then
      [[ "$val" =~ ^[0-9]+$ ]] && [ "$val" -ge 100000 ] || { echo "100000 이상 숫자(예: 500000) 또는 auto를 주세요."; exit 1; }
    fi
    if [ -n "$id" ]; then
      need_id "$id"; f="$CONF_DIR/$id.conf"
      [ -e "$f" ] || { echo "없는 세션이에요: $id"; exit 1; }
    else
      install -d -m 755 /etc/claude-vps; f=/etc/claude-vps/defaults.conf; touch "$f"
    fi
    sed -i '/^AUTOCOMPACT_WINDOW=/d' "$f"
    [ "$val" = auto ] || echo "AUTOCOMPACT_WINDOW=\"$val\"" >> "$f"
    echo "저장했어요 ($f: ${val}). 이미 떠 있는 세션은 다시 켜야 적용돼요: vps-session restart <아이디>"
    echo "(텔레그램 세션 안에서 자기 자신을 다시 켜면 답장이 끊겨요. telegram 세션은 앱 대화에서 다시 켜세요.)"
    ;;
  doctor)
    ok() { printf '  [ok] %s\n' "$1"; }; bad() { printf '  [!!] %s\n' "$1"; }
    echo "설치 점검"
    command -v claude >/dev/null && ok "claude $(claude --version 2>/dev/null | head -1)" || bad "claude 없음"
    command -v tmux >/dev/null && ok "tmux $(tmux -V)" || bad "tmux 없음 (apt-get install -y tmux)"
    [ -f /etc/systemd/system/claude-session@.service ] && ok "서비스 파일" || bad "서비스 파일 없음 (install.sh)"
    [ -f /root/.claude/skills/24h/SKILL.md ] && ok "/24h 스킬" || bad "/24h 스킬 없음 (install.sh)"
    if claude auth status >/dev/null 2>&1; then ok "서버 Claude 로그인"; else bad "서버 Claude 로그인 안 됨 (Terminal 창에서 claude auth login)"; fi
    # Login end date (Claude Code v2.1.318+). Using Claude does not extend it.
    ends=$(claude auth status --text 2>/dev/null | grep -m1 '^Sign-in' || true)
    [ -n "$ends" ] && echo "  [..] $ends  (그 전에 Terminal 창에서 claude auth login)"
    if [ -x /root/.bun/bin/bun ]; then ok "bun (텔레그램용)"; else echo "  [--] bun 없음 (텔레그램 쓸 때만 필요)"; fi
    if user_enabled; then
      bad "텔레그램 플러그인이 모든 세션에 켜짐 → 다른 세션이 봇을 가로챔 (claude plugin disable telegram@claude-plugins-official --scope user)"
    fi
    plugins_now=$(claude plugin list 2>/dev/null || true)
    if grep -q 'telegram@anthropic-plugin-directory' <<<"$plugins_now"; then
      bad "승인 목록 밖 카탈로그의 텔레그램 플러그인이 있음 (claude plugin uninstall telegram@anthropic-plugin-directory)"
    fi
    for f in "$CONF_DIR"/*.conf; do
      [ -e "$f" ] || continue
      grep -q '^TELEGRAM="\{0,1\}yes' "$f" || continue
      wd=$(sed -n 's/^WORKDIR="\(.*\)"$/\1/p' "$f")
      if folder_enabled "$wd"; then ok "텔레그램 플러그인: $(basename "$f" .conf) 세션 폴더에만 켜짐"
      else bad "텔레그램 세션 폴더($wd)에 플러그인이 안 켜짐 (cd $wd && claude plugin enable telegram@claude-plugins-official --scope local)"; fi
    done
    pa=$(sshd -T 2>/dev/null | awk '/^passwordauthentication /{print $2}')
    [ "$pa" = "no" ] && ok "비밀번호 로그인 꺼짐" || echo "  [--] 비밀번호 로그인 켜짐 (vps-session harden-ssh)"
    ufw status 2>/dev/null | head -1 | sed 's/^/  [fw] /'
    ac=$(sed -n 's/^AUTOCOMPACT_WINDOW="\{0,1\}\([0-9]*\).*/\1/p' /etc/claude-vps/defaults.conf 2>/dev/null | tail -1)
    echo "  [..] 대화 정리 시점(모든 세션 기본): ${ac:-기본값(모델이 정한 대로)}"
    if systemctl is-enabled claude-login-check.timer >/dev/null 2>&1; then ok "로그인 만료 텔레그램 알림 (매일 9시 확인)"; else echo "  [--] 로그인 만료 텔레그램 알림 꺼짐 (SETUP 6-7)"; fi
    ;;
  harden-ssh)
    grep -q '^ssh-' /root/.ssh/authorized_keys 2>/dev/null || { echo "authorized_keys에 공개 키가 없어요. 열쇠부터 넣으세요(SETUP 4-2)."; exit 1; }
    printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\nPermitRootLogin prohibit-password\n' > /etc/ssh/sshd_config.d/01-key-only.conf
    if sshd -t; then
      systemctl restart ssh
      sshd -T | grep -iE '^(passwordauthentication|kbdinteractiveauthentication|permitrootlogin) '
      echo "되돌리기(Web Console): rm /etc/ssh/sshd_config.d/01-key-only.conf && systemctl restart ssh"
    else
      rm -f /etc/ssh/sshd_config.d/01-key-only.conf
      echo "SSH 설정 검사에 실패해서 되돌렸어요. 아무것도 바뀌지 않았어요."; exit 1
    fi
    ;;
  firewall-basic)
    command -v ufw >/dev/null || apt-get install -y ufw
    ufw allow OpenSSH
    ufw default deny incoming
    ufw default allow outgoing
    ufw --force enable
    ufw status verbose
    echo "되돌리기(Web Console): ufw disable"
    ;;
  firewall-tailscale)
    ip link show tailscale0 >/dev/null 2>&1 || { echo "Tailscale이 켜져 있지 않아요(tailscale up 먼저)."; exit 1; }
    # The app's helper can outlive the connection that started it, so this is only a hint.
    case "${SSH_CONNECTION:-} " in 100.*) ;; *) echo "참고: 이 셸이 Tailscale 주소로 연결됐는지 확실하지 않아요. 앱의 100.x 연결로 붙는 걸 사용자가 확인한 뒤에만 진행하세요." ;; esac
    command -v ufw >/dev/null || apt-get install -y ufw
    ufw allow in on tailscale0
    ufw default deny incoming
    ufw default allow outgoing
    ufw --force enable
    ufw delete allow OpenSSH 2>/dev/null || true
    ufw delete allow 22/tcp 2>/dev/null || true
    ufw delete allow 22 2>/dev/null || true
    ufw status verbose
    echo "확인(노트북): ssh -o ConnectTimeout=10 root@<공인IP> 가 시간 초과면 성공"
    echo "되돌리기(Web Console): ufw disable"
    ;;
  ""|-h|--help|help) usage ;;
  *) echo "모르는 명령: $cmd"; usage; exit 1 ;;
esac
