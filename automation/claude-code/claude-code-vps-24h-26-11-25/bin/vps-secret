#!/usr/bin/env bash
# Store a secret on the server without showing it on screen, and check it without printing it.
#   vps-secret set telegram     # asks for the bot token (hidden input)
#   vps-secret check telegram   # calls Telegram getMe, prints only ok + bot username
set -euo pipefail

cmd="${1:-}"; what="${2:-}"
env_file="/root/.claude/channels/telegram/.env"

case "$cmd:$what" in
  set:telegram)
    install -d -m 700 "$(dirname "$env_file")"
    read -rsp "텔레그램 봇 토큰을 붙여 넣고 엔터 (화면에 안 보여요): " token; echo
    token="$(printf '%s' "$token" | tr -d '[:space:]')"
    if ! [[ "$token" =~ ^[0-9]+:[A-Za-z0-9_-]{30,}$ ]]; then
      echo "토큰 모양이 아니에요. BotFather가 준 '숫자:글자' 한 줄 전체를 붙여 넣어 주세요."; exit 1
    fi
    umask 077
    printf 'TELEGRAM_BOT_TOKEN=%s\n' "$token" > "$env_file"
    chmod 600 "$env_file"
    unset token
    echo "저장했어요: $env_file (나만 읽기)"
    ;;
  check:telegram)
    [ -r "$env_file" ] || { echo "토큰 파일이 없어요. 먼저: vps-secret set telegram"; exit 1; }
    token="$(sed -n 's/^TELEGRAM_BOT_TOKEN=//p' "$env_file" | tr -d "\"' \r")"
    # Pass the URL through curl's config on stdin so the token never appears in the process list.
    out="$(printf 'url = "https://api.telegram.org/bot%s/getMe"\n' "$token" | curl -s --max-time 15 -K - || true)"
    unset token
    printf '%s\n' "$out" | grep -o '"ok":[a-z]*\|"username":"[^"]*"' || echo "응답 없음(잠시 뒤 다시 시도)"
    ;;
  *)
    echo "사용법: vps-secret set telegram | vps-secret check telegram"; exit 1
    ;;
esac
